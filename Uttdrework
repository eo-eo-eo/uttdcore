TabLobby:CreateButton{
    Name = "Morph all obtainable",
    Callback = function()
        local function generateArgsFromRanges(...)
            local args = {}
            for _, range in ipairs({...}) do
                local startNum, endNum = range:match("^(%d+)%-(%d+)$")
                if startNum and endNum then
                    startNum, endNum = tonumber(startNum), tonumber(endNum)
                    for i = startNum, endNum do
                        table.insert(args, i)
                    end
                else
                    table.insert(args, tonumber(range))
                end
            end
            return args
        end
        local ranges = {"1001-1032", "1039-1052", "1501-1512", "2002-2006", "2008-2013", "3004-3006"}
        local args = generateArgsFromRanges(unpack(ranges))
        for _, arg in ipairs(args) do
            game:GetService("ReplicatedStorage").Title:FireServer(arg)
        end
    end
}
